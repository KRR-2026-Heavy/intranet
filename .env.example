# Local development uses the Vite /api proxy. Set a public HTTPS backend URL in Vercel.
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
KRR_CORS_ALLOWED_ORIGIN_PATTERNS=https://intranet-ezpy.vercel.app,http://localhost:[*],http://127.0.0.1:[*],http://192.168.26.96:[*]
KRR_SQLSERVER_URL=
KRR_SQLSERVER_USERNAME=
KRR_SQLSERVER_PASSWORD=
